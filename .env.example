# =============================================================================
# NeuroAssess environment template
# Copy to .env.local and fill in. NEVER commit real secrets or patient data.
# =============================================================================

# Database (PostgreSQL). Use a local Postgres or a managed provider.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/neuroassess?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# Environment: development | staging | production
NEUROASSESS_ENV="development"

# ---------------------------------------------------------------------------
# Clinical AI (all disabled by default; synthetic transcripts only)
# ---------------------------------------------------------------------------
# Approved cloud model provider (leave blank to keep cloud provider disabled)
CLOUD_MODEL_API_KEY=""
CLOUD_MODEL_BASE_URL=""

# Local model provider (development only)
LOCAL_MODEL_BASE_URL="http://localhost:11434"
LOCAL_MODEL_NAME="llama3"

# Deterministic synthetic provider used by tests and the vertical slice
SYNTHETIC_AI_ENABLED="true"

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Comma-separated allow-list for CORS
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# Webhook signature verification secret
WEBHOOK_SIGNING_SECRET="replace-me"

# ---------------------------------------------------------------------------
# Observability (privacy-conscious; no clinical narrative is logged)
# ---------------------------------------------------------------------------
LOG_LEVEL="info"
